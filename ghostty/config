# font-family = "JetBrainsMono Nerd Font Mono"
font-family = "Iosevka Custom"

font-size = 14
# theme = Kanagawa Wave
# theme = Ayu
theme= moonfly
confirm-close-surface = false
window-padding-x = 4
# window-padding-y = 14
window-theme = ghostty
gtk-toolbar-style = flat
# comment for default beh
# background-opacity = 0.3
# background-blur-radius = 90

cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor,sudo,ssh-terminfo,ssh-env
adjust-underline-position = 4
copy-on-select = clipboard

adjust-cell-height = 45%
bold-is-bright = true
link-url = true
mouse-hide-while-typing = true

window-inherit-working-directory = true
# config-file = non_tmux_config
shell-integration = fish
command = fish
app-notifications = no-clipboard-copy
clipboard-write=allow
clipboard-read=allow
 # window-padding-color = extend-always 
 window-padding-balance=true
config-file = tmux
# config-file = non_tmux
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
